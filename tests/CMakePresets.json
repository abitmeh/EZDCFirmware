{
    "version": 3,
    "configurePresets": [
        {
            "name": "host-tests",
            "displayName": "Host Tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-tests",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "host-tests"
        }
    ]
}
